{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gerar-titulo.js": {
      "maxDuration": 30
    },
    "api/crm-sla.js": {
      "maxDuration": 60
    },
    "api/analisar-dossie.js": {
      "maxDuration": 120
    },
    "api/acessos.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
